{
  "name": "saucedemo-playwright-cucumber",
  "version": "1.0.0",
  "description": "Playwright TypeScript Cucumber framework for SauceDemo testing",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:chrome": "cross-env BROWSER=chromium npm run test",
    "test:firefox": "cross-env BROWSER=firefox npm run test",
    "test:safari": "cross-env BROWSER=webkit npm run test",
    "test:headed": "cross-env HEADED=true npm run test",
    "test:debug": "cross-env DEBUG=true HEADED=true npm run test",
    "test:visible": "cross-env HEADED=true npm run test",
    "test:smoke": "npm run test -- --tags @smoke",
    "test:smoke:visible": "cross-env HEADED=true npm run test -- --tags @smoke",
    "test:positive": "npm run test -- --tags @positive",
    "test:negative": "npm run test -- --tags @negative",
    "test:login": "npm run test -- --tags @login",
    "test:login:visible": "cross-env HEADED=true npm run test -- --tags @login",
    "test:inventory": "npm run test -- --tags @inventory",
    "test:cart": "npm run test -- --tags @cart",
    "test:checkout": "npm run test -- --tags @checkout",
    "report": "node src/utils/generateReport.js",
    "clean": "rimraf reports screenshots videos"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.1",
    "@types/node": "^20.0.0",
    "chai-as-promised": "^7.1.2",
    "cross-env": "^10.0.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@cucumber/cucumber": "^10.6.0",
    "@cucumber/pretty-formatter": "^1.0.1",
    "chai": "^5.1.0",
    "crypto-js": "^4.2.0",
    "cucumber-html-reporter": "^7.1.0",
    "playwright": "^1.43.1"
  }
}
