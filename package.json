{
  "name": "saucedemo-playwright-cucumber",
  "version": "1.0.0",
  "description": "Playwright TypeScript Cucumber framework for SauceDemo testing",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "cucumber-js",
    "test:chrome": "cross-env BROWSER=chromium cucumber-js",
    "test:firefox": "cross-env BROWSER=firefox cucumber-js",
    "test:safari": "cross-env BROWSER=webkit cucumber-js",
    "test:headed": "cross-env HEADED=true cucumber-js",
    "test:debug": "cross-env DEBUG=true HEADED=true cucumber-js",
    "test:visible": "cross-env HEADED=true cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:smoke:headless": "cross-env BROWSER=chromium HEADED=false REPORT_DIR=reports/smoke node tests/run-smoke.js",
    "test:full:headless": "cross-env BROWSER=chromium HEADED=false REPORT_DIR=reports/full cucumber-js",
    "test:smoke:visible": "cross-env HEADED=true cucumber-js --tags @smoke",
    "test:positive": "cucumber-js --tags @positive",
    "test:negative": "cucumber-js --tags @negative",
    "test:login": "cucumber-js --tags @login",
    "test:login:visible": "cross-env HEADED=true cucumber-js --tags @login",
    "test:inventory": "cucumber-js --tags @inventory",
    "test:cart": "cucumber-js --tags @cart",
    "test:checkout": "cucumber-js --tags @checkout",
    "test:checkout:local": "tsx tests/local/run-checkout.ts correct",
    "test:checkout:controls": "tsx tests/local/run-checkout.ts negative",
    "typecheck": "tsc --noEmit",
    "bdd:dry": "cucumber-js --dry-run",
    "clean": "node -e \"const { rmSync } = require('node:fs'); for (const directory of ['reports', 'screenshots', 'videos']) rmSync(directory, { recursive: true, force: true });\""
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "cross-env": "^10.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@cucumber/cucumber": "13.3.0",
    "playwright": "1.65.1"
  }
}
